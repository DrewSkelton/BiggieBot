{
  "name": "biggiebot",
  "version": "1.0.0",
  "description": "A simple Discord bot with multiple features",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "migrate": "npx drizzle-kit generate --config drizzle.config.js"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
