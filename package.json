    "mathjs": "^15.2.0",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/node-cron": "^3.0.11",
    "drizzle-kit": "^0.31.10",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2"
  },
  "prettier": {
    "semi": false
